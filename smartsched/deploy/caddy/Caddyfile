# Automatic HTTPS in front of the SmartSched nginx proxy (docker-compose.caddy.yml).
# TLS_DOMAIN must resolve to this host and ports 80/443 must be reachable for the ACME challenge.
{
	email {$ACME_EMAIL}
}

{$TLS_DOMAIN} {
	# SSE (solver progress) must not be buffered; nginx also disables buffering for those paths.
	reverse_proxy proxy:8080 {
		flush_interval -1
	}
	request_body {
		max_size 50MB
	}
	# voice input (VO-05): one clip of at most 5 MB
	request_body /api/v1/ai/voice/transcribe {
		max_size 6MB
	}
	# Security headers (W3-SEC, docs/SECURITY.md §5). nginx behind this edge sets the full set (CSP with the
	# /grafana/ frame-ancestors exception, X-Frame-Options, Permissions-Policy); "?" only fills in what is missing,
	# so the proxy's (or a nonce-based frontend's) values win.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		?X-Content-Type-Options "nosniff"
		?Referrer-Policy "strict-origin-when-cross-origin"
		?X-Frame-Options "DENY"
		?Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self' https://login.microsoftonline.com; frame-ancestors 'none'"
		?Permissions-Policy "camera=(), microphone=(self), geolocation=(), payment=(), usb=(), interest-cohort=()"
		?Cross-Origin-Opener-Policy "same-origin"
		-Server
		-X-Powered-By
	}
	log {
		output stdout
		format console
	}
}
