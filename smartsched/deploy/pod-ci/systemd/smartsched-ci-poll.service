[Unit]
Description=SmartSched pod CI: poll GitHub for new commits, heartbeat, idle self-stop
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=smartsched-ci
Group=smartsched-ci
SupplementaryGroups=docker
EnvironmentFile=-/etc/smartsched-ci/ci.env
Environment=PYTHONPATH=/opt/smartsched-ci PYTHONDONTWRITEBYTECODE=1 PODCI_CONFIG=/etc/smartsched-ci/ci.env
WorkingDirectory=/opt/smartsched-ci
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes
ExecStart=/usr/bin/python3 -m podci poll
TimeoutStartSec=300
