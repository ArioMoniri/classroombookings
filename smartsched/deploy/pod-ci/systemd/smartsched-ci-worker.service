[Unit]
Description=SmartSched pod CI: run queued jobs one at a time
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
User=smartsched-ci
Group=smartsched-ci
SupplementaryGroups=docker
EnvironmentFile=-/etc/smartsched-ci/ci.env
Environment=PYTHONPATH=/opt/smartsched-ci PYTHONDONTWRITEBYTECODE=1 PODCI_CONFIG=/etc/smartsched-ci/ci.env
WorkingDirectory=/opt/smartsched-ci
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes
ExecStart=/usr/bin/python3 -m podci work
# A full run (images + e2e) takes 30-60 min on t4g.large; the worker drains the whole queue.
TimeoutStartSec=6h
KillMode=control-group
