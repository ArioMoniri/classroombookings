[Unit]
Description=SmartSched pod CI: run queued jobs one at a time
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
User=smartsched-ci
Group=smartsched-ci
SupplementaryGroups=docker
EnvironmentFile=-/etc/smartsched-ci/ci.env
Environment=PYTHONPATH=/opt/smartsched-ci PYTHONDONTWRITEBYTECODE=1 PODCI_CONFIG=/etc/smartsched-ci/ci.env
WorkingDirectory=/opt/smartsched-ci
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes
ExecStart=/usr/bin/python3 -m podci work
# The worker drains the whole queue in one activation, and a run with sharded e2e takes ~1.2 h, so a fixed limit
# killed it mid-run (6h: gracious run #127 requeued at 17:10 after a worker started at 11:10). Each gate has its own
# timeout (podci/gates.py), so the activation itself has none.
TimeoutStartSec=infinity
KillMode=control-group
