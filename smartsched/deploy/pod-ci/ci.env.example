# /etc/smartsched-ci/ci.env (written by install.sh from this file + the pod's user-data values).
# Every key is optional; defaults live in podci/config.py.
PODCI_REPO=ArioMoniri/classroombookings
# Branches polled every 2 minutes (comma separated) and the one that is redeployed when green.
PODCI_BRANCHES=claude/gracious-cerf-w1598m,claude/smartsched-universal
PODCI_DEPLOY_BRANCH=claude/gracious-cerf-w1598m
# https://<panel domain>; commit statuses link to <PUBLIC_URL>/ci/runs/<id>.
PODCI_PUBLIC_URL=
PODCI_SSM_PREFIX=/smartsched
PODCI_STATE_DIR=/var/lib/smartsched-ci
PODCI_DEPLOY_DIR=/opt/smartsched/src
# deploy.sh flags for the redeploy (comma separated); --tls = Caddy + Let's Encrypt on 80/443.
PODCI_DEPLOY_FLAGS=--tls
PODCI_WEB_BIND=172.17.0.1
PODCI_WEB_PORT=8095
PODCI_DISK_MAX_PERCENT=70
PODCI_KEEP_RUNS=50
PODCI_GATE_CPUS=2
PODCI_GATE_MEMORY=3g
# Idle self-stop (and the CloudWatch alarm whose actions are paused during CI jobs).
PODCI_IDLE_STOP=1
PODCI_IDLE_ALARM=smartsched-pod-idle-stop
PODCI_IDLE_MINUTES=60
PODCI_IDLE_CPU=5
# 0 = no AWS calls (local testing); then set PODCI_TOKEN_FILE to a file holding the GitHub token.
PODCI_CLOUD=1
PODCI_TOKEN_FILE=
