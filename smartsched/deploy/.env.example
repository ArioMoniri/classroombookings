# SmartSched deployment configuration. deploy.sh copies this to .env on first run and replaces every
# __GENERATE__ placeholder with a random value. Never commit .env (it is git-ignored).
# Every variable referenced by docker-compose.yml is listed here (deploy/validate.sh enforces it).
#
# FORMAT RULE: comments go on their own line. Docker Compose's .env parser keeps an inline
# "   # comment" after an EMPTY value as the value itself.

# ---- compose ------------------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=smartsched
# Tag for the locally built backend/frontend/crbs images.
SMARTSCHED_TAG=0.1.0
# Host port + bind address of the nginx proxy (http://localhost:8080).
# Use PROXY_BIND=127.0.0.1 when a host TLS terminator (Caddy/certbot+nginx) sits in front.
PROXY_PORT=8080
PROXY_BIND=0.0.0.0
# How browsers reach the app, e.g. https://smartsched.example.edu.tr (printed by deploy.sh; empty =
# http://localhost:PROXY_PORT). Off localhost this must be https://: the session cookie is marked
# Secure in production builds, so plain-http logins from other machines fail (README.md "TLS").
PUBLIC_URL=

# ---- secrets (generated by deploy.sh) ---------------------------------------------------------
# Backend master secret: Fernet key for API keys stored in settings + studio run seals (>= 32 chars).
APP_SECRET=__GENERATE__
# JWT signing key (>= 32 chars, different from APP_SECRET). With ENVIRONMENT=prod the backend refuses to
# start when either secret is missing, a placeholder (change-me, secret, ...) or too short.
JWT_SECRET=__GENERATE__
POSTGRES_PASSWORD=__GENERATE__
# The administrator, seeded on first start only (when the users table is empty). ADMIN_EMAIL has no
# default: set the real address here or run `ADMIN_EMAIL=you@university.edu.tr ./deploy.sh` (deploy.sh
# refuses an empty or example.* address). With ENVIRONMENT=prod the backend refuses an ADMIN_PASSWORD
# shorter than 12 characters or a default (admin, change-me, ...), and the first login must change it.
ADMIN_EMAIL=
ADMIN_PASSWORD=__GENERATE__

# ---- database -----------------------------------------------------------------------------------
POSTGRES_USER=smartsched
POSTGRES_DB=smartsched
# Leave empty to derive postgresql+psycopg://POSTGRES_USER:POSTGRES_PASSWORD@db:5432/POSTGRES_DB.
DATABASE_URL=

# ---- backend ------------------------------------------------------------------------------------
# dev | test | prod (anything else stops the backend). prod never auto-creates tables (alembic upgrade
# head runs in the container entrypoint), checks the secrets above and serves no /api/docs.
ENVIRONMENT=prod
CORS_ORIGINS=["http://localhost:8080"]
JWT_EXPIRE_MINUTES=720
# Proxy hops whose X-Forwarded-For the backend believes (uvicorn --forwarded-allow-ips and the sign-in caps). The
# default covers loopback and Docker's 172.16.0.0/12 bridge pools; name the compose subnet if the daemon uses others
# (docker network inspect smartsched_default). Never '*'.
FORWARDED_ALLOW_IPS=127.0.0.1,::1,172.16.0.0/12
# uvicorn processes. Each has its own in-process job queue (solves and workbook parsing run off the
# event loop, so one process stays responsive during a solve); README.md "Scaling".
UVICORN_WORKERS=2
# alembic upgrade head on start (set 0 on extra replicas so only one container migrates).
RUN_MIGRATIONS=1
# Create ADMIN_EMAIL/ADMIN_PASSWORD when the users table is empty.
SEED_ADMIN=1
SOLVER_DEFAULT_TIME_LIMIT=60
# CP-SAT search threads per solve; keep <= BACKEND_CPUS.
SOLVER_WORKERS=8
# Optional server-wide fallback; planners can store a key in /settings instead.
ANTHROPIC_API_KEY=
# Empty = the built-in default model; Settings -> AI overrides it.
ANTHROPIC_MODEL=

# ---- Ingestion Council: /onboarding, any files in any format (docs/universal/ARCHITECTURE.md) ----
# 1 = use Claude in the council when a key is configured; 0 = deterministic path only (heuristic
# mapping + the university importers), no model calls even with a key.
COUNCIL_AI=1
# (KVKK) with COUNCIL_AI=1 the council still sends no file content to Claude until an administrator turns on
# "council AI" under Settings > AI (setting council_ai_enabled, default off).
COUNCIL_MODEL=
# Model for vision transcription (images, scans) and the judge; empty = COUNCIL_MODEL.
# claude-haiku-5-5 is much cheaper for those two roles.
COUNCIL_FAST_MODEL=
# Items below this confidence (0..1) go to human review before commit.
COUNCIL_REVIEW_THRESHOLD=0.75
# Seconds per council step (one agent on one file) before it is stopped and reported.
COUNCIL_STEP_TIMEOUT_S=300
# Input+output tokens per onboarding job; when spent, the remaining steps run without the model.
COUNCIL_JOB_TOKEN_BUDGET=600000
# Upload limits per job (the nginx proxy accepts at most 50 MB per request in total).
COUNCIL_MAX_FILES=25
COUNCIL_MAX_FILE_MB=15
COUNCIL_MAX_JOB_MB=50
# Model votes per sheet for the column mapping (majority; 1 = one vote + the heuristic voter).
COUNCIL_SELF_CONSISTENCY=1
# Records per file the model judge compares with their source rows; 0 = judge off.
COUNCIL_JUDGE_SAMPLE=12
# Extra pip packages baked into the backend image, e.g. pymysql for `import crbs --dsn mysql://...`.
BACKEND_EXTRA_PIP=

# Stored uploads (source workbooks, intake documents) older than this are deleted by purge-uploads.sh
# (daily timer on the pod; cron elsewhere). Room photos and the logo (uploads/rooms) are kept.
UPLOAD_RETENTION_DAYS=30

# ---- frontend (NEXT_PUBLIC_* are inlined at image build time: rebuild after changing) -----------
# URL the Next.js server uses to reach FastAPI (it proxies /api/v1/* and attaches the session JWT).
NEXT_PUBLIC_API_URL=http://backend:8000

# ---- resource limits (examples for ~1 500 sections; README.md "Sizing") ------------------------
BACKEND_CPUS=4
# deploy.sh writes 3500m here when it turns the observability profile on (8 GB pod: limits 7.75 GB in total);
# any other value you set is kept.
BACKEND_MEMORY=4g
# The backend's /tmp is a tmpfs (memory, never disk: Starlette spools uploads over 1 MiB there in plain bytes, and a
# CRBS upgrade copies its dumps and builds a temporary SQLite file there). Its pages count against BACKEND_MEMORY.
# Budget: a request body is at most 50 MB (nginx), so one CRBS upgrade needs about 150 MB (spool + copy + SQLite;
# only one runs at a time, a second gets 409) and every other upload in flight up to 50 MB: 256m covers one upgrade
# plus two concurrent large uploads. A full /tmp makes uploads fail with 500, never spill to disk.
BACKEND_TMPFS=256m
FRONTEND_CPUS=1
FRONTEND_MEMORY=1g
DB_CPUS=2
DB_MEMORY=2g
PROXY_MEMORY=256m

# ---- legacy CRBS profile (./deploy.sh --legacy or docker compose --profile legacy) --------------
# Bound to localhost by default: the legacy app is for imports during the transition.
CRBS_PORT=8081
CRBS_BIND=127.0.0.1
CRBS_DB_NAME=crbs
CRBS_DB_USER=crbs
CRBS_DB_PASSWORD=__GENERATE__
CRBS_DB_ROOT_PASSWORD=__GENERATE__

# ---- optional TLS edge (./deploy.sh --tls, docker-compose.caddy.yml) ---------------------------
# Public DNS name of this server and the Let's Encrypt account e-mail. Also set
# PUBLIC_URL=https://<TLS_DOMAIN> and CORS_ORIGINS=["https://<TLS_DOMAIN>"].
TLS_DOMAIN=
ACME_EMAIL=

# ---- observability profile (./deploy.sh --observability; observability/README.md) ---------------
# Grafana's built-in admin (its login form is disabled: SmartSched admins reach /grafana/ through the proxy).
GRAFANA_ADMIN_PASSWORD=__GENERATE__
# Retention: metrics 15 days / at most 1 GB on disk (logs: 7 days in observability/loki/loki.yaml; error groups:
# 90 days in the database).
PROMETHEUS_RETENTION=15d
PROMETHEUS_RETENTION_SIZE=1GB
# Memory caps (together 768 MiB).
PROMETHEUS_MEMORY=160m
LOKI_MEMORY=128m
GRAFANA_MEMORY=384m
ALLOY_MEMORY=96m
# Internal URLs the operations panel (/admin/ops) probes; empty = the compose defaults (grafana / prometheus /
# loki services).
OPS_GRAFANA_URL=
OPS_PROMETHEUS_URL=
OPS_LOKI_URL=
# The pod CI page for the "pod CI" card, e.g. http://172.17.0.1:8095/ci/ on the AWS pod; empty = card off.
OPS_PODCI_URL=
# backup.sh's success metric file, read for the last-backup card on /admin/ops; empty = the compose default
# (/host/textfile/backup.prom).
OPS_BACKUP_TEXTFILE=
# Set by deploy.sh on every start (the deployed commit and time); leave empty here.
RELEASE_SHA=
DEPLOYED_AT=
# Optional: forward error events to Sentry (also needs BACKEND_EXTRA_PIP=sentry-sdk). Empty = no Sentry.
SENTRY_DSN=
# Optional bearer token for GET /metrics; empty = private network addresses only (Prometheus on the compose net).
METRICS_TOKEN=

# ---- deploy-time settings (NOT .env keys) -------------------------------------------------------------------------
# ORG_NAME, AI_PROVIDER, AI_API_KEY, AI_BASE_URL, SMTP_HOST/PORT/SECURITY/USERNAME/PASSWORD/FROM/FROM_NAME,
# SECURITY_CONTACT, GOOGLE_/MICROSOFT_CLIENT_ID/_SECRET, MICROSOFT_TENANT go to the database, not here: give them to
# deploy.sh as flags / environment variables (docs/deploy/ONE-CLICK.md). They are written once (seed/
# bootstrap_settings.py); afterwards the admin panel owns them.

# ---- ollama profile (optional local model server; docs/deploy/local-models.md) ----------------------
# `docker compose --env-file .env --profile ollama up -d ollama`; off by default, not for the 8 GB pod.
# Context length in tokens (the helper needs >= 8192; 16384 recommended) and the container's memory cap.
OLLAMA_CONTEXT_LENGTH=16384
OLLAMA_MEMORY=12g
