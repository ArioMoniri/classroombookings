# SmartSched deployment configuration — copy to .env (deploy.sh does this and fills the secrets).
# Never commit .env. Every variable used by docker-compose.yml is listed here.

# ---- compose -----------------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=smartsched
SMARTSCHED_TAG=latest              # image tag for the locally built backend/frontend images
PROXY_PORT=8080                    # host port of the nginx proxy → http://localhost:8080
PUBLIC_URL=http://localhost:8080   # how browsers reach the app (CORS, links in docs)

# ---- secrets (deploy.sh generates random values when the placeholders are still here) ----------
APP_SECRET=__GENERATE__            # backend master secret: JWT signing + Fernet key for stored API keys
JWT_SECRET=__GENERATE__            # reserved for a dedicated JWT key; the backend signs with APP_SECRET today
AUTH_SECRET=__GENERATE__           # frontend (Next.js) cookie/session secret
POSTGRES_PASSWORD=__GENERATE__
ADMIN_EMAIL=admin@example.edu.tr
ADMIN_PASSWORD=__GENERATE__        # seeded on first start only (users table empty); change it after login

# ---- database ------------------------------------------------------------------------------------
POSTGRES_USER=smartsched
POSTGRES_DB=smartsched
# Leave empty to derive postgresql+psycopg://POSTGRES_USER:POSTGRES_PASSWORD@db:5432/POSTGRES_DB
DATABASE_URL=

# ---- backend -------------------------------------------------------------------------------------
ENVIRONMENT=prod                   # prod never auto-creates tables; alembic runs on start
CORS_ORIGINS=["http://localhost:8080"]
JWT_EXPIRE_MINUTES=720
UVICORN_WORKERS=2                  # 1 = live SSE progress from the in-process queue on every request
SOLVER_DEFAULT_TIME_LIMIT=60
SOLVER_WORKERS=8                   # CP-SAT threads; keep <= BACKEND_CPUS
ANTHROPIC_API_KEY=                 # optional fallback; planners can store a key in /settings instead
ANTHROPIC_MODEL=claude-sonnet-5-5
BACKEND_EXTRA_PIP=                 # e.g. "pymysql" to enable `import crbs --dsn mysql://…`

# ---- frontend (NEXT_PUBLIC_* are baked in at image build time) -----------------------------------
NEXT_PUBLIC_API_URL=http://backend:8000   # the Next.js server proxies /api/v1 to this URL
NEXT_PUBLIC_API_MOCK=0

# ---- resource limits (examples; see deploy/README.md "Sizing") -----------------------------------
BACKEND_CPUS=4
BACKEND_MEMORY=4g
FRONTEND_CPUS=1
FRONTEND_MEMORY=1g
DB_CPUS=2
DB_MEMORY=2g
PROXY_MEMORY=256m

# ---- legacy CRBS profile (docker compose --profile legacy) ---------------------------------------
CRBS_PORT=8081
CRBS_DB_NAME=crbs
CRBS_DB_USER=crbs
CRBS_DB_PASSWORD=__GENERATE__
CRBS_DB_ROOT_PASSWORD=__GENERATE__
