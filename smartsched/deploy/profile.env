# What a one-click deploy of THIS branch loads on first boot (smartsched/deploy/seed/seed.py, run by deploy.sh).
#   institution  the owner's Bahar / Güz / Final workbooks + room master, their preference rules, learning extraction
#   empty        nothing: the setup wizard + /onboarding (claude/smartsched-universal)
# Branch-specific: .gitattributes marks this file merge=ours, so merging one branch into the other keeps the
# target's profile (needs `git config merge.ours.driver true` once per clone). Missing file = empty.
SEED_PROFILE=empty
