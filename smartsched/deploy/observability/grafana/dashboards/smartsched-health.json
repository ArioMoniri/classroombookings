{
  "uid": "smartsched-health",
  "title": "Servis sağlığı / Service health",
  "tags": [
    "smartsched",
    "health"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Operasyon / Operations",
      "type": "link",
      "url": "/admin/ops",
      "targetBlank": false
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Servisler ayakta / Services up",
      "datasource": {
        "type": "prometheus",
        "uid": "smartsched-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "red"
              },
              {
                "value": 1,
                "color": "green"
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "KAPALI / DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "AÇIK / UP",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up",
          "legendFormat": "{{job}}",
          "datasource": {
            "type": "prometheus",
            "uid": "smartsched-prometheus"
          }
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "HTTP denetimleri / HTTP probes",
      "datasource": {
        "type": "prometheus",
        "uid": "smartsched-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "red"
              },
              {
                "value": 1,
                "color": "green"
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "KAPALI / DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "AÇIK / UP",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_success",
          "legendFormat": "{{job}}",
          "datasource": {
            "type": "prometheus",
            "uid": "smartsched-prometheus"
          }
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Veritabanı / Database",
      "datasource": {
        "type": "prometheus",
        "uid": "smartsched-prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "red"
              },
              {
                "value": 1,
                "color": "green"
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "KAPALI / DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "AÇIK / UP",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "smartsched_db_up",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "smartsched-prometheus"
          }
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Bellek (servisler) / Memory (services)",
      "datasource": {
        "type": "prometheus",
        "uid": "smartsched-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "process_resident_memory_bytes{job!=\"backend\"}",
          "legendFormat": "{{job}}",
          "datasource": {
            "type": "prometheus",
            "uid": "smartsched-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "max(smartsched_process_resident_memory_bytes)",
          "legendFormat": "backend",
          "datasource": {
            "type": "prometheus",
            "uid": "smartsched-prometheus"
          }
        },
        {
          "refId": "C",
          "expr": "node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes",
          "legendFormat": "sunucu kullanılan / host used",
          "datasource": {
            "type": "prometheus",
            "uid": "smartsched-prometheus"
          }
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "CPU (sunucu) / CPU (host)",
      "datasource": {
        "type": "prometheus",
        "uid": "smartsched-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m]))",
          "legendFormat": "kullanım / used",
          "datasource": {
            "type": "prometheus",
            "uid": "smartsched-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "node_load1",
          "legendFormat": "load 1m",
          "datasource": {
            "type": "prometheus",
            "uid": "smartsched-prometheus"
          }
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Disk doluluğu / Disk used",
      "datasource": {
        "type": "prometheus",
        "uid": "smartsched-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay\"} / node_filesystem_size_bytes{fstype!~\"tmpfs|overlay\"}",
          "legendFormat": "{{mountpoint}}",
          "datasource": {
            "type": "prometheus",
            "uid": "smartsched-prometheus"
          }
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Veritabanı bağlantıları / DB connections",
      "datasource": {
        "type": "prometheus",
        "uid": "smartsched-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(pg_stat_database_numbackends)",
          "legendFormat": "bağlantı / connections",
          "datasource": {
            "type": "prometheus",
            "uid": "smartsched-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "max(pg_settings_max_connections)",
          "legendFormat": "üst sınır / max",
          "datasource": {
            "type": "prometheus",
            "uid": "smartsched-prometheus"
          }
        },
        {
          "refId": "C",
          "expr": "sum(smartsched_db_pool_connections{state=\"checked_out\"})",
          "legendFormat": "havuz kullanımda / pool checked out",
          "datasource": {
            "type": "prometheus",
            "uid": "smartsched-prometheus"
          }
        }
      ]
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Sertifika (gün) / Certificate (days)",
      "datasource": {
        "type": "prometheus",
        "uid": "smartsched-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "red"
              },
              {
                "value": 14,
                "color": "orange"
              },
              {
                "value": 30,
                "color": "green"
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "smartsched_tls_cert_expiry_seconds / 86400",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "smartsched-prometheus"
          }
        }
      ]
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Son yedek (saat önce) / Last backup (hours ago)",
      "datasource": {
        "type": "prometheus",
        "uid": "smartsched-prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 21,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 26,
                "color": "red"
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(time() - smartsched_backup_last_success_timestamp_seconds) / 3600",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "smartsched-prometheus"
          }
        }
      ]
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Sürüm / Release",
      "datasource": {
        "type": "prometheus",
        "uid": "smartsched-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "smartsched_build_info",
          "legendFormat": "{{version}} {{release}}",
          "datasource": {
            "type": "prometheus",
            "uid": "smartsched-prometheus"
          }
        }
      ]
    }
  ]
}
