{
  "uid": "smartsched-bookings",
  "title": "Rezervasyonlar ve onaylar / Bookings & approvals",
  "tags": [
    "smartsched",
    "bookings"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Operasyon / Operations",
      "type": "link",
      "url": "/admin/ops",
      "targetBlank": false
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Rezervasyonlar / Bookings",
      "datasource": {
        "type": "prometheus",
        "uid": "smartsched-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (event) (increase(smartsched_domain_events_total{event=~\"booking_.*\"}[1h]))",
          "legendFormat": "{{event}} / sa",
          "datasource": {
            "type": "prometheus",
            "uid": "smartsched-prometheus"
          }
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Son 24 saatte oluşturulan / Created in 24 h",
      "datasource": {
        "type": "prometheus",
        "uid": "smartsched-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "smartsched_bookings_created_24h",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "smartsched-prometheus"
          }
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Bekleyen onaylar / Pending approvals",
      "datasource": {
        "type": "prometheus",
        "uid": "smartsched-prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 20,
                "color": "orange"
              },
              {
                "value": 100,
                "color": "red"
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(smartsched_approval_requests{status=\"PENDING\"})",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "smartsched-prometheus"
          }
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Onay talepleri / Approval requests",
      "datasource": {
        "type": "prometheus",
        "uid": "smartsched-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "smartsched_approval_requests",
          "legendFormat": "{{status}}",
          "datasource": {
            "type": "prometheus",
            "uid": "smartsched-prometheus"
          }
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Onay kararları / Approval decisions",
      "datasource": {
        "type": "prometheus",
        "uid": "smartsched-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(smartsched_domain_events_total{event=\"approval_decided\"}[1h]))",
          "legendFormat": "karar / decisions per h",
          "datasource": {
            "type": "prometheus",
            "uid": "smartsched-prometheus"
          }
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Rezervasyon durumları / Booking states",
      "datasource": {
        "type": "prometheus",
        "uid": "smartsched-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "smartsched_bookings",
          "legendFormat": "{{status}}",
          "datasource": {
            "type": "prometheus",
            "uid": "smartsched-prometheus"
          }
        }
      ]
    }
  ]
}
