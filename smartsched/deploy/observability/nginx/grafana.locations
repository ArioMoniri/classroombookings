    # ---- Grafana (compose profile "observability", W3-OPS) behind the SmartSched admin session --------------
    # auth_request asks the backend (through the Next.js handler, which turns the session cookie into the bearer
    # token) whether the caller is an admin: 204 -> proxied with X-WEBAUTH-USER (Grafana auth.proxy), 401 -> the
    # login page, 403 -> 403. The client's own X-WEBAUTH-USER never reaches Grafana (always overwritten).
    # A variable upstream + Docker's resolver: nginx starts (and /grafana/ answers 502) when Grafana is not running.
    location = /grafana { return 301 /grafana/; }
    location /grafana/ {
        auth_request /_ops/grafana-auth;
        error_page 401 = @grafana_login;
        resolver 127.0.0.11 valid=30s ipv6=off;
        set $smartsched_grafana http://grafana:3000;
        proxy_pass $smartsched_grafana;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        $connection_upgrade;
        proxy_set_header X-WEBAUTH-USER    smartsched-admin;
        proxy_set_header Authorization     "";
    }
    location = /_ops/grafana-auth {
        internal;
        proxy_pass http://smartsched_frontend/api/v1/ops/grafana-auth;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Host            $host;
        proxy_set_header X-Original-URI  $request_uri;
        proxy_set_header Cookie          $http_cookie;
    }
    location @grafana_login {
        return 302 /login?next=$request_uri;
    }
