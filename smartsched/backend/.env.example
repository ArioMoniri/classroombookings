# Local development settings (scripts/dev.sh writes smartsched/backend/.env from this file).
# Production values come from smartsched/deploy/.env, generated by deploy.sh or the pod; never reuse these.
# Every setting read by app/core/config.py and app/importers/settings.py is listed below; a commented line
# shows the built-in default and may be left out. Comments go on their own line, never after a value.

# dev | test | prod. prod never changes the schema on start and refuses default, short or shared secrets.
ENVIRONMENT=dev
# DEBUG=false
# Async SQLAlchemy URL. Production: postgresql+psycopg://USER:PASSWORD@HOST/DB
DATABASE_URL=sqlite+aiosqlite:///./smartsched.db
# Migrate a dev/test SQLite database on start (ignored in prod).
# CREATE_TABLES_ON_STARTUP=true
# SQLITE_BUSY_TIMEOUT_MS=15000

# APP_SECRET / JWT_SECRET: dev.sh generates random values; leave empty here.
# APP_SECRET encrypts stored API keys and OAuth client secrets (Fernet) and seals studio runs: back it up.
# JWT_SECRET signs the session tokens; in prod it is required, >= 32 characters and different from APP_SECRET
# (dev/test fall back to APP_SECRET). Generate with: openssl rand -base64 48
APP_SECRET=
JWT_SECRET=
# JWT_ALGORITHM=HS256
# Session lifetime in minutes (12 h).
# JWT_EXPIRE_MINUTES=720
# Bearer token for scraping /metrics without a user session; otherwise /metrics needs a planning.admin session.
# METRICS_TOKEN=

# The dev admin: DEV_ADMIN_EMAIL / DEV_ADMIN_PASSWORD, else your git e-mail and a random password printed once.
# ADMIN_EMAIL / ADMIN_PASSWORD seed the first administrator when the users table is empty; leave the password
# empty once the admin exists. In prod the password must have >= 12 characters and not be a placeholder.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# JSON list of browser origins allowed to call the API.
CORS_ORIGINS=["http://localhost:3000"]
# How browsers reach the panel (https://… off localhost). Calendar feed links and OAuth redirect URIs are built
# from it unless the admin setting integrations.public_url overrides it.
# PUBLIC_URL=

# Fallbacks when no key / model is stored under Settings -> AI. Without a key, AI features are off.
# ANTHROPIC_API_KEY=
# Empty = the built-in default model; Settings -> AI overrides it.
ANTHROPIC_MODEL=

# Solver defaults (per run overridable) and their upper bounds.
SOLVER_DEFAULT_TIME_LIMIT=60
SOLVER_WORKERS=8
# SOLVER_MAX_TIME_LIMIT=3600
# SOLVER_MAX_WORKERS=16
# Queued + running runs one user may have (429 above).
# MAX_ACTIVE_RUNS_PER_USER=3
# Job control: liveness beat, orphan threshold at start, wall-clock cap (factor x time limit + margin), stop grace.
# RUN_HEARTBEAT_S=15
# RUN_STALE_AFTER_S=90
# RUN_WALL_CLOCK_FACTOR=5
# RUN_WALL_CLOCK_MARGIN_S=300
# RUN_CANCEL_GRACE_S=30

# Uploaded workbooks and room photos (only /uploads/rooms is served publicly).
UPLOAD_DIR=./uploads
# Safe upload intake: size of one upload, limits for .xlsx/.docx archives and sheets, parsing in a child process.
# UPLOAD_MAX_MB=25
# ZIP_MAX_UNCOMPRESSED_MB=50
# ZIP_MAX_MEMBER_MB=20
# ZIP_MAX_RATIO=100
# SHEET_MAX_ROWS=20000
# SHEET_MAX_COLS=1024
# process (memory-limited child) | thread
# PARSE_ISOLATION=process
# PARSE_MEMORY_MB=2048
# PARSE_TIMEOUT_S=300

# Importer switches (prefix IMPORT_, read on every import).
# JSON list of words that mark a definitive-room cell as a non-room venue (default: a Turkish + English list
# with CASE, office, ONLINE, UZEM, Zoom, Teams, club ...); such a row needs no room. Setting it replaces the
# whole default list (see DEFAULT_NON_ROOM_VENUES in app/importers/settings.py).
# IMPORT_NON_ROOM_VENUES=["case","online","uzem"]
# Carry the last week's grid blocks into weeks that have no sheet in the weekly board (default: report them).
# IMPORT_GRID_CARRY_FORWARD=false

# Solver room-overlap encoding (read from the process environment by app/solver): 2d (default) | classes.
# SMARTSCHED_ROOM_ENCODING=2d
# Tests only: 1 enables the slow solver scale tests.
# SMARTSCHED_SLOW=1
