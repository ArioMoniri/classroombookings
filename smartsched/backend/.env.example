# Local development settings (scripts/dev.sh writes smartsched/backend/.env from this file).
# Production values come from smartsched/deploy/.env, generated by deploy.sh or the pod; never reuse these.
ENVIRONMENT=dev
DATABASE_URL=sqlite+aiosqlite:///./smartsched.db
# APP_SECRET / JWT_SECRET: dev.sh generates random values; leave empty here.
APP_SECRET=
JWT_SECRET=
# The dev admin: DEV_ADMIN_EMAIL / DEV_ADMIN_PASSWORD, else your git e-mail and a random password printed once.
ADMIN_EMAIL=
ADMIN_PASSWORD=
CORS_ORIGINS=["http://localhost:3000"]
# ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
SOLVER_DEFAULT_TIME_LIMIT=60
SOLVER_WORKERS=8
UPLOAD_DIR=./uploads
