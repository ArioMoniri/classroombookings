# Backend base URL (FastAPI). The Next.js route handler /api/v1/* proxies to it.
NEXT_PUBLIC_API_URL=http://localhost:8000
# 1 = serve realistic in-memory mock data (MSW handlers) instead of the backend.
NEXT_PUBLIC_API_MOCK=1
# Used to sign the mock session cookie / local dev only.
AUTH_SECRET=change-me
